rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: O usuario precisa estar autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verifica se o documento pertence ao usuario logado
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Verifica se o usuario possui a role de treinador no Firestore
    function isTrainer() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'trainer';
    }

    // Colecao: users
    match /users/{userId} {
      allow read: if isOwner(userId) || isTrainer();
      
      allow create: if isAuthenticated() && (
        isOwner(userId) || isTrainer()
      );
      
      allow update: if isTrainer() || (
        isOwner(userId) && 
        request.resource.data.userType == resource.data.userType &&
        request.resource.data.trainerId == resource.data.trainerId
      );
      
      allow delete: if isTrainer();
    }

    // Colecao: workoutPlans (Planos de Treino)
    match /workoutPlans/{planId} {
      allow read: if isTrainer() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
      // Permite que o treinador escreva OU que o proprio aluno salve seu treino gerado por IA
      allow create: if isTrainer() || (isAuthenticated() && request.resource.data.clientId == request.auth.uid);
      allow update, delete: if isTrainer() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }

    // Colecao: workoutDays (Dias e Exercicios)
    match /workoutDays/{dayId} {
      allow read: if isAuthenticated();
      // Permite que treinador ou aluno autenticado configure dias de treino vinculados
      allow write: if isAuthenticated();
    }

    // Colecao: workoutLogs (Historico de Treinos do Aluno)
    match /workoutLogs/{logId} {
      allow read: if isTrainer() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isTrainer() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }

    // Colecao: exercises (Biblioteca de Exercicios)
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isTrainer();
    }

    // Colecao: motivationalQuotes (Frases do Dia)
    match /motivationalQuotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isTrainer();
    }

    // Colecao: progressPhotos (Cofre de Fotos de Evolucao)
    match /progressPhotos/{photoId} {
      allow read: if isTrainer() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow delete: if isTrainer() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }

    // Colecao: communityPosts (Feed da Comunidade)
    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isTrainer() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Colecao: dailyHabits (Checklist diario de agua, dieta, sono)
    match /dailyHabits/{habitId} {
      allow read, write: if isAuthenticated();
    }
  }
}
